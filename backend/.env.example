# RAFTAR Backend Configuration
PORT=4000
NODE_ENV=development
API_VERSION=v1

# PostgreSQL + PostGIS Connection
DATABASE_URL=postgresql://raftar_admin:raftar_secure_pass@localhost:5432/raftar_db

# Redis Connection
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=raftar_super_secret_jwt_access_key_2026_production
JWT_REFRESH_SECRET=raftar_super_secret_jwt_refresh_key_2026_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
